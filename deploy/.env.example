# ─── FWT VPS dağıtımı ─────────────────────────────────────────────────────────
#
# Bu dosyayı `.env` olarak kopyala ve doldur. `.env` depoya girmez.
# Tanımsız bırakılan zorunlu değerlerde `docker compose up` açılışta durur —
# sessizce güvensiz başlamaktansa hiç başlamaması tercih edildi.
#
# Rastgele değer üretmek için:  openssl rand -hex 32

# Sitenin alan adı. Şema (https://) YAZMA, yalnızca alan adı.
# DNS A kaydı bu VPS'in IP'sine bakıyor olmalı, yoksa TLS sertifikası alınamaz.
FWT_DOMAIN=example.com

# ─── Veritabanı ───────────────────────────────────────────────────────────────
POSTGRES_USER=fwt
POSTGRES_DB=fwt
POSTGRES_PASSWORD=

# ─── Kimlik doğrulama ─────────────────────────────────────────────────────────
# En az 32 karakter. Örnek dosyalardaki değerler reddedilir.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── Servis token'ı ───────────────────────────────────────────────────────────
# Bu değer hem FWT backend'ine hem MP4 servisine aynı anda verilir; compose
# ikisini de buradan okur, yani tek yerde tutuluyor.
MP4_INTERNAL_TOKEN=

# ─── İsteğe bağlı ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# MP4 Avcısı geçici dosya tavanı (bayt). Çıktılar bir saat sonra silinir.
MP4_MAX_DISK_BYTES=4831838208

# MP4 Avcısı imajı VPN'i açık geliyor. Yapılandırılmış WireGuard yoksa
# Tor/privoxy boşuna ayağa kalkar, o yüzden varsayılan kapalı. Bölgesel erişim
# hataları için VPN kurduysan 1 yap (bkz. mp4-avcisi README).
MP4_VPN_AUTO=0
