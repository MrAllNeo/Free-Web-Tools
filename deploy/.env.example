# ─── FWT VPS dağıtımı ─────────────────────────────────────────────────────────
#
# Bu dosyayı `.env` olarak kopyala ve doldur. `.env` depoya girmez.
# Tanımsız bırakılan zorunlu değerlerde `docker compose up` açılışta durur —
# sessizce güvensiz başlamaktansa hiç başlamaması tercih edildi.
#
# Rastgele değer üretmek için:  openssl rand -hex 32

# Sitenin alan adı. Şema (https://) YAZMA, yalnızca alan adı.
# DNS A kaydı bu VPS'in IP'sine bakıyor olmalı, yoksa TLS sertifikası alınamaz.
FWT_DOMAIN=example.com

# ─── Veritabanı ───────────────────────────────────────────────────────────────
POSTGRES_USER=fwt
POSTGRES_DB=fwt
POSTGRES_PASSWORD=

# ─── Kimlik doğrulama ─────────────────────────────────────────────────────────
# En az 32 karakter. Örnek dosyalardaki değerler reddedilir.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ─── Servis token'ları ────────────────────────────────────────────────────────
# Bu değerler hem FWT backend'ine hem ilgili servise aynı anda verilir; compose
# ikisini de buradan okur, yani tek yerde tutuluyorlar.
MP4_INTERNAL_TOKEN=
SAHNE_INTERNAL_TOKEN=

# Sahne Avcısı'nın yönetici uçları (FMHY eşitleme, indeksleme kuyruğu) için.
# FWT bunu kullanmaz; yalnızca sen elle çağırırken gerekir.
SAHNE_ADMIN_TOKEN=

# ─── İsteğe bağlı ─────────────────────────────────────────────────────────────
# trace.moe misafir kotasıyla anahtarsız da çalışır.
TRACE_MOE_API_KEY=

LOG_LEVEL=info

# Sahne servisinin istemci başına istek bütçesi (0 = kapalı).
# Caddy arkasında tüm kullanıcılar tek IP'den görünmez; TRUST_PROXY sayesinde
# backend gerçek IP'yi görür, ama sahne servisine istek yalnızca backend'den
# gelir. Yani bu sınır pratikte backend'in toplam hızını sınırlar.
SAHNE_RATE_LIMIT=60
SAHNE_RATE_WINDOW=60

# İndeksleme worker'ı. Çekirdek sayısını aşmanın faydası yok; --per-host
# kaynak siteye karşı nezaket sınırıdır, onu yükseltirken dikkatli ol.
SAHNE_WORKER_CONCURRENCY=3
SAHNE_WORKER_PER_HOST=2

# MP4 Avcısı geçici dosya tavanı (bayt). Çıktılar bir saat sonra silinir.
MP4_MAX_DISK_BYTES=4831838208

# MP4 Avcısı imajı VPN'i açık geliyor. Yapılandırılmış WireGuard yoksa
# Tor/privoxy boşuna ayağa kalkar, o yüzden varsayılan kapalı. Bölgesel erişim
# hataları için VPN kurduysan 1 yap (bkz. mp4-avcisi README).
MP4_VPN_AUTO=0
