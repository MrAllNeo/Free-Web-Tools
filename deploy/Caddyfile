# TLS sertifikasi Let's Encrypt'ten otomatik alinir ve yenilenir; 80 ve 443
# portlarinin disaridan erisilebilir olmasi yeterli.

{$FWT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Sunucu yazilimini ve surumunu duyurmanin faydasi yok.
		-Server
	}

	# API uclari kucuk JSON gorur; buyuk govde kabul etmek gereksiz bir
	# saldiri yuzeyi acar.
	handle /api/* {
		request_body {
			max_size 2MB
		}
		reverse_proxy backend:3001
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
