# Backend Environment Variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/freewebtools?schema=public"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="24h"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Ters vekil (nginx, Cloudflare, platform yönlendiricisi) arkasında çalışıyorsan
# güvenilen vekil sayısını yaz — hız sınırlayıcı gerçek istemci IP'sini böyle görür.
# Vekil yoksa BOŞ BIRAK: aksi hâlde istemci kendi IP'sini uydurup sınırı aşabilir.
# TRUST_PROXY=1
