generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  guest
  user
  contributor
  admin
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

/// Bir snippet'in üst kısmında ne gösterileceği.
/// `live` yalnızca frontend kategorisinde anlamlıdır ve kod iframe içinde çalıştırılır.
enum MediaType {
  video
  image
  live
  none
}

enum VideoSource {
  youtube
  internal
}

enum SnippetStatus {
  draft
  pending
  approved
  rejected
}

enum CommentStatus {
  pending
  approved
  rejected
}

enum InteractionAction {
  like
  save
  report
  view
}

enum ContributionAction {
  uploaded
  updated
  reported
  reviewed
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String?   @map("full_name")
  bio             String?
  role            Role      @default(user)
  reputationScore Int       @default(0) @map("reputation_score")
  profileVerified Boolean   @default(false) @map("profile_verified")
  avatarUrl       String?   @map("avatar_url")
  githubUrl       String?   @map("github_url")
  websiteUrl      String?   @map("website_url")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  lastLogin       DateTime? @map("last_login")

  snippets      Snippet[]
  comments      Comment[]
  interactions  UserInteraction[]
  contributions ContributionHistory[]
  shortLinks    ShortLink[]

  notifications     Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")
  reports           Report[]

  @@map("users")
}

model ShortLink {
  id          String    @id @default(uuid())
  originalUrl String    @map("original_url")
  slug        String    @unique @db.VarChar(16)
  // Misafirler de link kısaltabilir, bu yüzden sahiplik opsiyonel.
  userId      String?   @map("user_id")
  clickCount  Int       @default(0) @map("click_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  // Kullanıcı silinse de kısa link çalışmaya devam etmeli.
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([userId])
  @@map("short_links")
}

model Snippet {
  id               String        @id @default(uuid())
  title            String
  slug             String        @unique
  description      String?
  codeContent      String        @map("code_content")
  codeLanguage     String        @map("code_language")

  // Katkıcının kendi yazdığı demo markup'ı.
  // Saf CSS ya da DOM'a bağlı JS tek başına ekranda hiçbir şey göstermez; hangi
  // markup'ın onu görünür kıldığını en iyi kodu yazan bilir. Doluysa canlı
  // önizleme bunu kullanır ve tahmin yürütmeye gerek kalmaz.
  demoHtml         String?       @map("demo_html")
  category         String        // frontend, backend, hacking
  difficulty       Difficulty    @default(beginner)
  tags             String[]

  // Gösterim ortamı.
  // Frontend snippet'leri her zaman canlı önizlemeyle gösterilir; bu alanlar
  // backend ve hacking kategorileri için geçerlidir ve katkıcı yüklerken seçer.
  mediaType            MediaType     @default(video) @map("media_type")
  videoUrl             String?       @map("video_url")
  videoSource          VideoSource   @default(youtube) @map("video_source")
  videoDurationSeconds Int?          @map("video_duration_seconds")
  imageUrl             String?       @map("image_url")
  imageCaption         String?       @map("image_caption")

  // Documentation
  documentationUrl String? @map("documentation_url")
  prerequisites    String?

  // Code Properties
  isExecutable Boolean? @map("is_executable")
  canDownload  Boolean  @default(true) @map("can_download")

  // Metadata
  createdBy     String @map("created_by")
  viewsCount    Int    @default(0) @map("views_count")
  likesCount    Int    @default(0) @map("likes_count")
  commentsCount Int    @default(0) @map("comments_count")
  averageRating Float  @default(0) @map("average_rating")

  // Status
  status          SnippetStatus @default(pending)
  rejectionReason String?       @map("rejection_reason")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  // Relations
  author       User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  comments     Comment[]
  interactions UserInteraction[]
  contributions ContributionHistory[]
  notifications Notification[]
  reports       Report[]

  @@index([category])
  @@index([codeLanguage])
  @@index([createdBy])
  @@index([slug])
  @@map("snippets")
}

model Comment {
  id              String        @id @default(uuid())
  snippetId       String        @map("snippet_id")
  userId          String        @map("user_id")
  parentCommentId String?       @map("parent_comment_id")
  content         String
  rating          Int?
  helpfulCount    Int           @default(0) @map("helpful_count")
  unhelpfulCount  Int           @default(0) @map("unhelpful_count")
  status          CommentStatus @default(approved)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  snippet       Snippet   @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentComment Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies       Comment[] @relation("CommentReplies")
  reports       Report[]

  @@index([snippetId])
  @@index([userId])
  @@map("comments")
}

model UserInteraction {
  id        String            @id @default(uuid())
  userId    String            @map("user_id")
  snippetId String            @map("snippet_id")
  action    InteractionAction
  createdAt DateTime          @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippet Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@unique([userId, snippetId, action])
  @@index([userId])
  @@index([snippetId])
  @@map("user_interactions")
}

model ContributionHistory {
  id        String             @id @default(uuid())
  userId    String             @map("user_id")
  snippetId String             @map("snippet_id")
  action    ContributionAction
  details   Json?
  createdAt DateTime           @default(now()) @map("created_at")

  // Relations
  //
  // İkisi de Cascade: `onDelete` belirtilmediğinde Prisma zorunlu ilişkilerde
  // Restrict uygular ve katkı geçmişi kaydı olan bir snippet SİLİNEMİYORDU.
  // Moderasyondan onay alan her snippet böyle bir kayıt oluşturduğundan,
  // "snippet'ini sil" özelliği tam da yayınlanmış snippet'lerde kırılıyordu.
  // Kayıt bir denetim izi; snippet gidince onunla birlikte gitmesi doğru.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  snippet Snippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  @@map("contribution_history")
}

/// Kullanıcının kendi içeriğinde olan biteni görmesi için.
/// E-posta göndermiyoruz; bildirim yalnızca site içinde durur.
enum NotificationType {
  comment_on_snippet
  reply_to_comment
  snippet_approved
  snippet_rejected
}

model Notification {
  id        String           @id @default(uuid())
  /// Bildirimi alan kişi.
  userId    String           @map("user_id")
  type      NotificationType
  /// Eylemi yapan kişi. Sistem kaynaklı bildirimlerde (onay/red) boş kalır.
  actorId   String?          @map("actor_id")
  snippetId String?          @map("snippet_id")
  commentId String?          @map("comment_id")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  snippet Snippet? @relation(fields: [snippetId], references: [id], onDelete: Cascade)

  /// Okunmamışları listelemek en sık yapılan sorgu.
  @@index([userId, readAt])
  @@map("notifications")
}

enum ReportReason {
  spam
  malicious
  offensive
  copyright
  other
}

enum ReportStatus {
  open
  resolved
  dismissed
}

/// Yayımlandıktan sonra kötüye kullanımı yakalamanın tek yolu.
/// Moderasyon yalnızca yayın öncesi çalışıyordu.
model Report {
  id         String       @id @default(uuid())
  /// Şikayet eden. Hesap silinse de şikayet moderasyon için durmalı.
  reporterId String?      @map("reporter_id")
  snippetId  String?      @map("snippet_id")
  commentId  String?      @map("comment_id")
  reason     ReportReason
  details    String?
  status     ReportStatus @default(open)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  reporter User?    @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  snippet  Snippet? @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}
